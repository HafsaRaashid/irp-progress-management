# apps/api runtime configuration. Copy to .env for local dev (git-ignored).
PORT=3001
NODE_ENV=development
APP_VERSION=0.0.0

# Postgres — docker-compose.yml publishes ${IRP_DB_PORT:-5432}. The repo
# convention is 5433 on every dev machine, so start the container with
# IRP_DB_PORT=5433 and keep this in step. (5432 is held by an unrelated
# container on at least one dev machine; standardising on 5433 keeps the
# connection string identical everywhere.) CI is unaffected and uses 5432 —
# do not "fix" the workflow to match this.
#
# Use 127.0.0.1, not localhost: localhost resolves to ::1 on these machines
# and Postgres is published on the IPv4 address.
DATABASE_URL=postgresql://irp:irp@127.0.0.1:5433/irp?schema=public

# NOTE: this file is only auto-loaded by `pnpm dev` (tsx --env-file=.env).
# The Prisma CLI does NOT read it — Prisma 7 dropped implicit .env loading, and
# prisma.config.ts resolves env("DATABASE_URL") from the real process env. So
# `prisma generate` / `migrate` fail with PrismaConfigEnvError unless you first:
#   $env:DATABASE_URL = "postgresql://irp:irp@127.0.0.1:5433/irp?schema=public"

# Microsoft Entra ID. Local dev/tests use a stubbed JWKS (see test/helpers/keys.ts);
# these are the production shape, swapped to the tenant in Plan 3.
JWKS_URI=https://login.microsoftonline.com/common/discovery/v2.0/keys
JWT_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
JWT_AUDIENCE=api://irp-progress-management

# FR-21 notifications (Plan 8). All optional — leave unset for local dev and
# CI; each channel independently no-ops with a single startup warning log
# when its config is missing or incomplete, rather than failing to boot.
# See ADR-0024 (Teams webhook) and ADR-0025 (SMTP via M365).
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATIONS_FROM_EMAIL=
# Where apps/web is hosted, for the deep link in a notification message.
# Distinct from apps/web's own AUTH_URL — apps/api has no other notion of it.
WEB_BASE_URL=http://localhost:3100
